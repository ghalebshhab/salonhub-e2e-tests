{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Booking response",
  "type": "object",
  "required": ["success", "message", "data"],
  "properties": {
    "success": { "type": "boolean" },
    "message": { "type": "string" },
    "data": {
      "type": "object",
      "required": ["id", "salonId", "salonName", "customerId", "customerName", "bookingDate",
                   "bookingTime", "status", "services", "totalPrice", "totalDurationMinutes", "createdAt"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "salonId": { "type": "integer", "minimum": 1 },
        "salonName": { "type": "string" },
        "customerId": { "type": "integer" },
        "customerName": { "type": "string" },
        "customerPhoneNumber": { "type": ["string", "null"] },
        "customerLocation": { "type": ["string", "null"] },
        "bookingDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "bookingTime": { "type": "string", "pattern": "^\\d{2}:\\d{2}(:\\d{2})?$" },
        "status": {
          "type": "string",
          "enum": ["PENDING", "ACCEPTED", "IN_PROGRESS", "REJECTED", "CANCELLED", "COMPLETED", "EXPIRED", "NO_SHOW"]
        },
        "services": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["serviceId", "name", "price", "durationMinutes"],
            "properties": {
              "serviceId": { "type": "integer" },
              "name": { "type": "string" },
              "price": { "type": "number" },
              "durationMinutes": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "totalPrice": { "type": "number", "minimum": 0 },
        "totalDurationMinutes": { "type": "integer", "minimum": 1 },
        "assignedEmployeeId": { "type": ["integer", "null"] },
        "note": { "type": ["string", "null"] },
        "rescheduleProposals": { "type": "array" },
        "createdAt": { "type": "string" }
      }
    }
  }
}
