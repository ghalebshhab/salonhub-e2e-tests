<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SalonHub smoke" parallel="classes" thread-count="4" verbose="1">
    <test name="smoke">
        <groups><run><include name="smoke"/></run></groups>
        <packages>
            <package name="com.salonhub.qa.api.*"/>
            <package name="com.salonhub.qa.ui.*"/>
            <package name="com.salonhub.qa.e2e.*"/>
        </packages>
    </test>
</suite>
